# Uploaded with the input directory. The container sources this file.
# Default is a 0.1 ps smoke (200 steps at 0.5 fs) on the image init.pdb.
MODE=smoke
GPU=0
STEPS=200

# Use a packed experimental box instead of init.pdb. The name is resolved
# under EXP_SYSTEMS. Leave unset to keep the image default.
# PDB=BF-200EC-20Li-20FSI.pdb

# Queue. Put list.tsv next to run.sh and switch MODE.
# Columns for nvt: system_id, pdb, temperature_K, seed, eq_ensemble, prod_ensemble
# Columns for 2fs and 4fs also include pressure_bar, forcefield, property.
# MODE=nvt
# LIST=list.tsv

# Boxes uploaded inside this input directory, or a mounted dataset.
# EXP_SYSTEMS=/path/to/exp_systems
